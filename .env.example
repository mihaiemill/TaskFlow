# Copiază acest fișier în ".env" și completează valorile reale.
# ".env" nu trebuie NICIODATĂ commis în git (e deja în .gitignore).

POSTGRES_DB=taskflow
POSTGRES_USER=taskflow_user
POSTGRES_PASSWORD=schimba-ma

# Minim 32 de caractere, folosit pentru semnarea token-urilor JWT.
JWT_KEY=schimba-ma-cu-o-cheie-lunga-si-aleatoare

# Parola inițială pentru admin@admin.com (minim 6 caractere). Folosită doar la prima pornire,
# pe o bază de date fără admin; contul de admin nu se mai poate crea prin „Creează cont nou”.
ADMIN_PASSWORD=schimba-ma

# Din Google Cloud Console → OAuth 2.0 Client IDs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
